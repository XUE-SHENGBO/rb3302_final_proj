<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Keep observed walls. Retry after a stationary sensor-refresh interval. -->
    <RecoveryNode number_of_retries="2" name="NavigateWithSafeRetry">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker" error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>
      <Wait wait_duration="1.0"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
