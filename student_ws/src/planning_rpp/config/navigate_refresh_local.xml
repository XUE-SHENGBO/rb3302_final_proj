<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateWithLocalRefresh">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker" error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>
      <Sequence name="RefreshLocalObservations">
        <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
        <ClearEntireCostmap name="RefreshLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>
        <Wait wait_duration="1.0"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
